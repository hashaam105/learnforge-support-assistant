# ---------------------------------------------------------------------------
# LearnForge Support Assistant - configuration
#
# The system runs with ZERO keys (BM25-only retrieval + a deterministic
# extractive generator). Add keys to enable dense retrieval and a real LLM.
# ---------------------------------------------------------------------------

# --- Generation: Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
LLM_PROVIDER=groq                       # groq | offline
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# --- Embeddings: Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini               # gemini | none  (none => BM25-only)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Storage ---
DB_PATH=learnforge.db
KB_PATH=data/learnforge-knowledge-base

# --- Retrieval ---
RETRIEVAL_CANDIDATES=24                 # per-branch candidate pool (BM25 + dense)
RETRIEVAL_TOP_K=5                       # chunks passed to the generator
RRF_K=60                                # reciprocal-rank-fusion smoothing constant
ENABLE_LLM_RERANK=true

# --- Confidence + escalation thresholds ---
MIN_DENSE_SCORE=0.62                    # cosine floor when dense retrieval is live
MIN_LEXICAL_SCORE=0.30                  # BM25-proxy floor in keyless/BM25-only mode
MIN_SCORE_MARGIN=0.04                   # top1 vs top2 separation
MIN_GROUNDEDNESS=0.70                   # verifier score below this => escalate
ENABLE_VERIFIER=true

# --- Freshness ---
STALE_AFTER_DAYS=365                    # docs older than this get a freshness caveat
TODAY_OVERRIDE=                         # ISO date, for deterministic tests
